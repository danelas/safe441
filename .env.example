# Safe 441 — environment variables
# Copy to .env.local for local dev, and add these in Vercel → Project → Settings → Environment Variables.

# --- Supabase (server-side only; service-role key bypasses RLS) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Verified sender. Domain must be verified in Resend before sending from it.
RESEND_FROM_EMAIL=Safe 441 <hello@safe441.org>
# Where private submission notifications are sent.
CAMPAIGN_EMAIL=hello@safe441.org

# NOTE: If Supabase or Resend vars are missing, submissions still return success
# in the browser but are logged/skipped server-side — set them before launch.
